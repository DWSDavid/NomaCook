{
  "schema_version": "1.0",
  "recipe_version_id": "rv_fried_rice_demo_1",
  "dish": "蛋炒饭",
  "language": "zh-CN",
  "ingredients": [
    {"name": "冷饭", "amount": "500 ml"},
    {"name": "鸡蛋", "amount": "2 个"},
    {"name": "火腿、胡萝卜或黄瓜丁", "amount": "各约 30 g，可选"},
